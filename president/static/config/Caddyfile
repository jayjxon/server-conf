{
    admin off
    auto_https off
}

:8080 {
    # the well-known files are compose configs, rendered from ${DOMAINNAME}
    handle /.well-known/* {
        header Access-Control-Allow-Origin "*"
        header Access-Control-Allow-Methods "OPTIONS,GET"

        root * /srv/well-known
        file_server
    }

    handle {
        header Access-Control-Allow-Origin "*"
        header Access-Control-Allow-Methods "OPTIONS,GET"

        root * /www
        file_server
    }

    respond "404 not found" 404
}

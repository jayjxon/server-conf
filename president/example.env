# general settings
PUID=1000
PGID=1000

DOMAINNAME=example.com

TZ=America/New_York

# absolute path to the directory containing the private application configs/data
APP_ROOT=

# allocate 100GiB for Pingvin storage
# this gets PREALLOCATED, so make sure you have enough space
# on the disk
PINGVIN_STORAGE_SIZE_MEGABITS=100000

# crowdsec bouncer key used by the traefik plugin
# create it once with:
# ```
# docker compose exec crowdsec cscli bouncers add traefik-bouncer
# ```
CROWDSEC_BOUNCER_LAPI_KEY=

# slug for uptime kuma widget on dashboard
UPTIME_KUMA_SLUG=

# Cloudflare API key for DNS challenge
CF_API_EMAIL=
CF_DNS_API_TOKEN=

# authelia admin password, stored as an argon2id digest instead of the plain text.
# generate it with:
# ```
# docker run --rm authelia/authelia:4.39.28 \
#   authelia crypto hash generate argon2 --password 'your-password'
# ```
# the value contains '$', so quote it as described in the README (step 3)
AUTHELIA_ADMIN_PASSWORD_HASH=

# add secret envs by running:
# ```
# echo "AUTHELIA_SESSION_SECRET=$(openssl rand -hex 32)" >> .env
# echo "AUTHELIA_STORAGE_ENCRYPTION_KEY=$(openssl rand -hex 32)" >> .env
# ```

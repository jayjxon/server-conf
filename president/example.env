# general settings
PUID=1000
PGID=1000

DOMAINNAME=example.com

TZ=America/New_York

# absolute path to the directory containing the private application configs/data
APP_ROOT=

# origin of the /data/* anime catalogue API used by anime-library
ANIME_CATALOG_BASE=

# allocate 100GiB for Pingvin storage
# this gets PREALLOCATED, so make sure you have enough space
# on the disk
PINGVIN_STORAGE_SIZE_MEGABITS=100000

# crowdsec bouncer key used by the traefik plugin
# create it once with:
# ```
# docker compose exec crowdsec cscli bouncers add traefik-bouncer
# ```
CROWDSEC_BOUNCER_LAPI_KEY=

# slug for uptime kuma widget on dashboard
UPTIME_KUMA_SLUG=

# tailscale exit node (president/exit-node). auth key from the tailscale admin
# console (Settings -> Keys); approve the node as an exit node afterwards
TAILSCALE_EXIT_NODE_AUTHKEY=

# Cloudflare API key for DNS challenge
CF_API_EMAIL=
CF_DNS_API_TOKEN=

# dispatcharr's django signing key (DJANGO_SECRET_KEY). the container fails to boot
# on a fresh volume when it is empty, so generate 50+ random alphanumeric characters:
# ```
# echo "DISPATCHARR_SECRET_KEY=$(openssl rand -hex 32)" >> .env
# ```
DISPATCHARR_SECRET_KEY=

# every request authelia let through reaches dispatcharr as this user, which has no usable
# password. create it once with the shell snippet in the README; dispatcharr keeps no login
# of its own
DISPATCHARR_SSO_USER=admin

# authelia admin password, stored as an argon2id digest instead of the plain text.
# generate it with:
# ```
# docker run --rm authelia/authelia:4.39.28 \
#   authelia crypto hash generate argon2 --password 'your-password'
# ```
# the value contains '$', so quote it as described in the README (step 3)
AUTHELIA_ADMIN_PASSWORD_HASH=

# authelia's oidc provider, used by pingvin share
# ```
# echo "AUTHELIA_OIDC_HMAC_SECRET=$(openssl rand -hex 32)" >> .env
# ```
AUTHELIA_OIDC_HMAC_SECRET=

# pingvin share's oidc client: the plaintext secret goes to pingvin, the same value
# hashed with pbkdf2 goes to authelia. the hash contains '$', so quote it.
# ```
# SECRET=$(openssl rand -hex 32)
# echo "PINGVIN_OIDC_CLIENT_SECRET=$SECRET" >> .env
# docker run --rm --entrypoint authelia authelia/authelia:4.39.28 \
#   crypto hash generate pbkdf2 --password "$SECRET" |
#   sed -n 's/^Digest: //p' | xargs -I{} echo "PINGVIN_OIDC_CLIENT_SECRET_HASH='{}'" >> .env
# ```
PINGVIN_OIDC_CLIENT_SECRET=
PINGVIN_OIDC_CLIENT_SECRET_HASH=''

# add secret envs by running:
# ```
# echo "AUTHELIA_SESSION_SECRET=$(openssl rand -hex 32)" >> .env
# echo "AUTHELIA_STORAGE_ENCRYPTION_KEY=$(openssl rand -hex 32)" >> .env
# ```

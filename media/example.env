# general settings
PUID=1000
PGID=1000

# absolute path to the directory where
# app data will be stored
APP_ROOT=

TZ=America/New_York

# domain WITHOUT http/https or slashes
# this one and INTERNAL_DOMAINNAME both need DNS records pointing at the
# external / internal tailscale addresses of this host
DOMAINNAME=media.domain.tld

# this HAS to have a DNS record pointing to internal tailscale IP
# auth is managed by ACLs in traefik
INTERNAL_DOMAINNAME=media.internal.domain.tld

# higher level domain with reverse proxy and authelia
# (president)
ROOT_DOMAINNAME=domain.tld

# theme for *ARRs
# see https://theme-park.dev for more details
TP_THEME=organizr

### tailscale ingress ###
# pre-auth keys for the two tailscale nodes that carry traefik
# NOTE: media/traefik/compose.yaml still logs into headscale, which was removed
# from this repo. Either drop the --login-server flag (Tailscale SaaS keys) or
# restore a control server before starting this stack.
HEADSCALE_INTERNAL_AUTHKEY=
HEADSCALE_EXTERNAL_AUTHKEY=

### torrenting ###
TORRENT_PORT=2048
# absolute path to where incomplete downloads will be stored
QBITTORRENT_INCOMPLETE_MOUNT=
# absolute path to where media will be stored
DATA_MOUNT_DIR=

### wireguard (gluetun) ###
WIREGUARD_PROVIDER=
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
WIREGUARD_PRESHARED_KEY=
# useful to select cities with the highest speeds / closest to you
WIREGUARD_SERVER_CITIES=

# Cloudflare API key for DNS challenge
CF_API_EMAIL=
CF_DNS_API_TOKEN=

### optional ###
# flaresolverr
LOG_LEVEL=info
LOG_HTML=false
CAPTCHA_SOLVER=none

# generate password envs with:
# ```
# echo "ARIA2_RPC_SECRET=$(openssl rand -base64 60 | tr -d '\n')" >> .env
# ```
